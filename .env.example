# Copia este archivo a .env.local para desarrollar con el stack local.
# NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY salen de `supabase status`.
# La anon key de ejemplo es la clave demo estándar de Supabase local (pública e
# idéntica en todos los proyectos locales; también está en tests/db/env.ts).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# NEXT_PUBLIC_SITE_URL = origin público de la app. Debe coincidir con el
# site_url de supabase/config.toml (http://localhost:3000): GoTrue solo permite
# redirects a URLs allowlistadas, así que el redirectTo de recuperación
# (origin + /auth/reset) se rechaza si el host difiere. F017: al usar
# @supabase/ssr, el code_verifier del OAuth se guarda en cookies del browser en
# este mismo host (localhost); unificar en localhost evita el mismatch de host
# que rompe el intercambio PKCE.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Service-role key (F012): SOLO server-side, nunca NEXT_PUBLIC. La usa
# createServiceRoleClient() (lib/supabase.ts) para lecturas donde el RLS
# oculta datos (embed del email del autor en la lista pública de reseñas).
# La clave de ejemplo es la service_role demo estándar de Supabase local
# (pública e idéntica en todos los proyectos locales; también en tests/db/env.ts).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# F017: OAuth con Google. Déjalas vacías para desarrollar; el config.toml usa
# default vacío (env(GOOGLE_OAUTH_CLIENT_ID, )) y `supabase start` arranca sin
# ellas. Con ellas se habilita "Continuar con Google". Sácalas de Google Cloud
# Console → Credentials → OAuth 2.0 Client ID (Web application). Ver docs/oauth-google.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
